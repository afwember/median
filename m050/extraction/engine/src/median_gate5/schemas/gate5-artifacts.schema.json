{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://median.invalid/schemas/m050/gate5-artifacts-0.1.json",
  "title": "MEDIAN v0.5.0 Gate 5 artifact contracts",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "nonempty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "source_identity_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "card_id", "version", "status", "source_id",
        "source_sha256", "genealogy", "roles", "allowed_streams",
        "supporting_block_ids", "exclusions"
      ],
      "properties": {
        "schema_version": {"const": "M050-SOURCE-IDENTITY-CARD-0.1"},
        "card_id": {"$ref": "#/$defs/nonempty_string"},
        "version": {"type": "integer", "minimum": 1},
        "status": {"enum": ["draft", "reviewed", "approved", "challenged", "superseded"]},
        "source_id": {"$ref": "#/$defs/nonempty_string"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "genealogy": {"$ref": "#/$defs/nonempty_string"},
        "roles": {"$ref": "#/$defs/string_array"},
        "allowed_streams": {"$ref": "#/$defs/string_array"},
        "supporting_block_ids": {"$ref": "#/$defs/string_array"},
        "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion_record"}},
        "supersedes_card_id": {"type": ["string", "null"]}
      }
    },
    "artifact_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"$ref": "#/$defs/nonempty_string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "identity_role_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "scope", "allowed_streams", "supporting_block_ids"],
      "properties": {
        "role": {"$ref": "#/$defs/nonempty_string"},
        "scope": {"$ref": "#/$defs/nonempty_string"},
        "allowed_streams": {"$ref": "#/$defs/string_array"},
        "supporting_block_ids": {"$ref": "#/$defs/nonempty_string_array"}
      }
    },
    "identity_status_region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "status", "block_ids", "handling"],
      "properties": {
        "label": {"$ref": "#/$defs/nonempty_string"},
        "status": {"enum": ["active", "mixed", "provisional", "open", "historical", "silent", "process_only", "change_record"]},
        "block_ids": {"$ref": "#/$defs/nonempty_string_array"},
        "handling": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "identity_predecessor_coverage_warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "coverage_status", "warning", "extraction_effect"],
      "properties": {
        "subject": {"$ref": "#/$defs/nonempty_string"},
        "coverage_status": {
          "enum": [
            "no_direct_predecessor_identified",
            "direct_predecessor_incomplete",
            "merged_partial_coverage",
            "named_predecessor_unavailable",
            "identical_migration_snapshot",
            "coverage_unknown"
          ]
        },
        "warning": {"$ref": "#/$defs/nonempty_string"},
        "extraction_effect": {"const": "warning_only_no_extraction_influence"}
      }
    },
    "legacy_extraction_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_summary", "source_bindings", "candidate", "acceptance_report",
        "record_count", "distinct_source_locations", "likely_compound_review_flags",
        "evidence_status", "reuse_disposition"
      ],
      "properties": {
        "lineage_summary": {"$ref": "#/$defs/nonempty_string"},
        "source_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_binding"}},
        "candidate": {"$ref": "#/$defs/artifact_binding"},
        "acceptance_report": {"$ref": "#/$defs/artifact_binding"},
        "record_count": {"type": "integer", "minimum": 1},
        "distinct_source_locations": {"type": "integer", "minimum": 1},
        "likely_compound_review_flags": {"type": "integer", "minimum": 0},
        "evidence_status": {"enum": ["immutable_legacy_candidate", "archived_legacy_candidate"]},
        "reuse_disposition": {"$ref": "#/$defs/nonempty_string"},
        "partition_warning": {"type": ["string", "null"]}
      }
    },
    "identity_migration_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligibility", "paid_reextraction_required", "mandatory_repairs", "prerequisites"],
      "properties": {
        "eligibility": {"enum": ["eligible_after_offline_repairs", "human_ruling_reconstruction_required", "blocked"]},
        "paid_reextraction_required": {"type": "boolean"},
        "mandatory_repairs": {"$ref": "#/$defs/nonempty_string_array"},
        "prerequisites": {"$ref": "#/$defs/nonempty_string_array"}
      }
    },
    "source_identity_card_v0_2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "card_id", "version", "status", "source_id",
        "source_path", "source_sha256", "frozen_manifest_binding",
        "block_manifest_binding", "source_disposition_binding",
        "reuse_disposition_binding", "genealogy_summary", "predecessor_bindings",
        "predecessor_coverage_warnings",
        "roles", "allowed_streams", "authority_boundary", "mixed_status_regions",
        "supporting_block_ids", "exclusions", "legacy_extraction", "migration",
        "supersedes_card_id"
      ],
      "properties": {
        "schema_version": {"const": "M050-SOURCE-IDENTITY-CARD-0.2"},
        "card_id": {"pattern": "^sic_[0-9a-f]{24}$", "type": "string"},
        "version": {"type": "integer", "minimum": 1},
        "status": {"enum": ["draft", "reviewed", "approved", "challenged", "superseded"]},
        "source_id": {"$ref": "#/$defs/nonempty_string"},
        "source_path": {"$ref": "#/$defs/nonempty_string"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "frozen_manifest_binding": {"$ref": "#/$defs/artifact_binding"},
        "block_manifest_binding": {"$ref": "#/$defs/artifact_binding"},
        "source_disposition_binding": {"$ref": "#/$defs/artifact_binding"},
        "reuse_disposition_binding": {"$ref": "#/$defs/artifact_binding"},
        "genealogy_summary": {"$ref": "#/$defs/nonempty_string"},
        "predecessor_bindings": {"type": "array", "items": {"$ref": "#/$defs/artifact_binding"}},
        "predecessor_coverage_warnings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/identity_predecessor_coverage_warning"}
        },
        "roles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identity_role_assignment"}},
        "allowed_streams": {"$ref": "#/$defs/nonempty_string_array"},
        "authority_boundary": {"$ref": "#/$defs/nonempty_string"},
        "mixed_status_regions": {"type": "array", "items": {"$ref": "#/$defs/identity_status_region"}},
        "supporting_block_ids": {"$ref": "#/$defs/nonempty_string_array"},
        "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion_record"}},
        "legacy_extraction": {"$ref": "#/$defs/legacy_extraction_binding"},
        "migration": {"$ref": "#/$defs/identity_migration_disposition"},
        "supersedes_card_id": {"type": ["string", "null"]}
      }
    },
    "source_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "profile_id", "source_id", "profile_version", "parsing_rules"],
      "properties": {
        "schema_version": {"const": "M050-SOURCE-PROFILE-0.1"},
        "profile_id": {"$ref": "#/$defs/nonempty_string"},
        "source_id": {"$ref": "#/$defs/nonempty_string"},
        "profile_version": {"type": "integer", "minimum": 1},
        "parsing_rules": {"type": "object"}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id", "source_id", "ordinal", "block_type", "start", "end",
        "raw_sha256", "text", "status_markers", "claim_bearing", "estimated_claims",
        "local_disposition", "local_reason_code"
      ],
      "properties": {
        "block_id": {"$ref": "#/$defs/nonempty_string"},
        "source_id": {"$ref": "#/$defs/nonempty_string"},
        "ordinal": {"type": "integer", "minimum": 1},
        "block_type": {"enum": ["heading", "paragraph", "list_item", "table_row", "code_fence", "whitespace"]},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "text": {"type": "string"},
        "parent_heading": {"type": ["string", "null"]},
        "status_markers": {"$ref": "#/$defs/string_array"},
        "claim_bearing": {"type": "boolean"},
        "estimated_claims": {"type": "integer", "minimum": 0},
        "local_disposition": {"enum": ["eligible", "context_only", "excluded", "review_required"]},
        "local_reason_code": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "block_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "manifest_id", "source_id", "source_sha256", "normalization_version", "blocks"],
      "properties": {
        "schema_version": {"const": "M050-BLOCK-MANIFEST-0.1"},
        "manifest_id": {"$ref": "#/$defs/nonempty_string"},
        "source_id": {"$ref": "#/$defs/nonempty_string"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "normalization_version": {"$ref": "#/$defs/nonempty_string"},
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}}
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "block_ids", "estimated_tokens", "claim_bearing_blocks"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "block_ids": {"$ref": "#/$defs/string_array"},
        "estimated_tokens": {"type": "integer", "minimum": 1},
        "claim_bearing_blocks": {"type": "integer", "minimum": 0},
        "review_risk": {"type": "integer", "minimum": 0}
      }
    },
    "chunk_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "plan_id", "source_id", "block_manifest_id", "max_tokens", "max_claim_blocks", "chunks"],
      "properties": {
        "schema_version": {"const": "M050-CHUNK-PLAN-0.1"},
        "plan_id": {"$ref": "#/$defs/nonempty_string"},
        "source_id": {"$ref": "#/$defs/nonempty_string"},
        "block_manifest_id": {"$ref": "#/$defs/nonempty_string"},
        "max_tokens": {"type": "integer", "minimum": 1},
        "max_claim_blocks": {"type": "integer", "minimum": 1},
        "chunks": {"type": "array", "items": {"$ref": "#/$defs/chunk"}}
      }
    },
    "work_order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "work_order_id", "version", "state", "source_id", "source_path",
        "source_sha256", "identity_card_id", "block_manifest_id", "chunk_plan_id",
        "allowed_block_ids", "allowed_streams",
        "prompt_version", "schema_id", "engine_version", "provider", "model",
        "request_token_limit", "output_token_limit", "claim_block_limit",
        "maximum_spend_cents", "maximum_requests", "retry_allowance", "stop_conditions",
        "expected_output_paths"
      ],
      "properties": {
        "schema_version": {"const": "M050-WORK-ORDER-0.1"},
        "work_order_id": {"$ref": "#/$defs/nonempty_string"},
        "version": {"type": "integer", "minimum": 1},
        "state": {"enum": ["draft", "offline_verified", "awaiting_authorization", "authorized", "active", "closed", "rejected", "cancelled", "failed_integrity", "failed_cost"]},
        "source_id": {"$ref": "#/$defs/nonempty_string"},
        "source_path": {"$ref": "#/$defs/nonempty_string"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "identity_card_id": {"$ref": "#/$defs/nonempty_string"},
        "block_manifest_id": {"$ref": "#/$defs/nonempty_string"},
        "chunk_plan_id": {"$ref": "#/$defs/nonempty_string"},
        "allowed_block_ids": {"$ref": "#/$defs/nonempty_string_array"},
        "allowed_streams": {"$ref": "#/$defs/nonempty_string_array"},
        "prompt_version": {"$ref": "#/$defs/nonempty_string"},
        "schema_id": {"$ref": "#/$defs/nonempty_string"},
        "engine_version": {"$ref": "#/$defs/nonempty_string"},
        "provider": {"$ref": "#/$defs/nonempty_string"},
        "model": {"$ref": "#/$defs/nonempty_string"},
        "request_token_limit": {"type": "integer", "minimum": 1},
        "output_token_limit": {"type": "integer", "minimum": 1},
        "claim_block_limit": {"type": "integer", "minimum": 1},
        "maximum_spend_cents": {"type": "integer", "minimum": 0},
        "maximum_requests": {"type": "integer", "minimum": 0},
        "retry_allowance": {"type": "integer", "minimum": 0},
        "stop_conditions": {"$ref": "#/$defs/nonempty_string_array"},
        "expected_output_paths": {"$ref": "#/$defs/nonempty_string_array"},
        "authorization_receipt_id": {"type": ["string", "null"]}
      }
    },
    "request_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "work_order_id", "state", "request_sha256", "payload_path"],
      "properties": {
        "schema_version": {"const": "M050-REQUEST-RECORD-0.1"},
        "request_id": {"$ref": "#/$defs/nonempty_string"},
        "work_order_id": {"$ref": "#/$defs/nonempty_string"},
        "state": {"enum": ["rendered", "verified", "authorized_for_send", "sent", "response_captured", "locally_processed", "dispositioned", "not_sent", "transport_failed", "cost_blocked", "truncated", "invalid_response", "retry_authorized"]},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "payload_path": {"$ref": "#/$defs/nonempty_string"},
        "predecessor_request_id": {"type": ["string", "null"]}
      }
    },
    "raw_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "response_id", "request_id", "raw_sha256", "raw_path", "captured_at"],
      "properties": {
        "schema_version": {"const": "M050-RAW-RESPONSE-0.1"},
        "response_id": {"$ref": "#/$defs/nonempty_string"},
        "request_id": {"$ref": "#/$defs/nonempty_string"},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "raw_path": {"$ref": "#/$defs/nonempty_string"},
        "captured_at": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "cost_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "receipt_id", "request_id", "provider", "model", "input_tokens", "output_tokens", "provider_cost_usd_raw", "accounted_cost_cents", "disposition"],
      "properties": {
        "schema_version": {"const": "M050-COST-RECEIPT-0.1"},
        "receipt_id": {"$ref": "#/$defs/nonempty_string"},
        "request_id": {"$ref": "#/$defs/nonempty_string"},
        "provider": {"$ref": "#/$defs/nonempty_string"},
        "model": {"$ref": "#/$defs/nonempty_string"},
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "provider_cost_usd_raw": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
        "accounted_cost_cents": {"type": "integer", "minimum": 0},
        "disposition": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "proposal_atom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "source_id", "block_id", "exact_source_text", "normalized_claim", "claim_kind", "stream"],
      "properties": {
        "proposal_id": {"$ref": "#/$defs/nonempty_string"},
        "source_id": {"$ref": "#/$defs/nonempty_string"},
        "block_id": {"$ref": "#/$defs/nonempty_string"},
        "exact_source_text": {"$ref": "#/$defs/nonempty_string"},
        "normalized_claim": {"$ref": "#/$defs/nonempty_string"},
        "claim_kind": {"$ref": "#/$defs/nonempty_string"},
        "stream": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "block_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "kind"],
      "properties": {
        "block_id": {"$ref": "#/$defs/nonempty_string"},
        "kind": {"enum": ["atoms", "no_substantive_claim", "excluded", "review_required"]},
        "atoms": {"type": "array", "items": {"$ref": "#/$defs/proposal_atom"}},
        "reason_code": {"type": "string"}
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "proposal_set_id", "request_id", "source_id", "dispositions"],
      "properties": {
        "schema_version": {"const": "M050-EVIDENCE-PROPOSAL-0.1"},
        "proposal_set_id": {"$ref": "#/$defs/nonempty_string"},
        "request_id": {"$ref": "#/$defs/nonempty_string"},
        "source_id": {"$ref": "#/$defs/nonempty_string"},
        "dispositions": {"type": "array", "items": {"$ref": "#/$defs/block_disposition"}}
      }
    },
    "exclusion_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exclusion_id", "block_id", "block_sha256", "stage", "reason_code", "decision_source", "review_state"],
      "properties": {
        "exclusion_id": {"$ref": "#/$defs/nonempty_string"},
        "block_id": {"$ref": "#/$defs/nonempty_string"},
        "block_sha256": {"$ref": "#/$defs/sha256"},
        "stage": {"enum": ["identity", "structural", "extraction", "review"]},
        "reason_code": {"$ref": "#/$defs/nonempty_string"},
        "decision_source": {"$ref": "#/$defs/nonempty_string"},
        "review_state": {"enum": ["pending", "reviewed", "accepted", "rejected", "challenged"]}
      }
    },
    "validation_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "report_id", "proposal_set_id", "validator_version", "passed", "checks", "normalization_events", "anomalies"],
      "properties": {
        "schema_version": {"const": "M050-VALIDATION-REPORT-0.1"},
        "report_id": {"$ref": "#/$defs/nonempty_string"},
        "proposal_set_id": {"$ref": "#/$defs/nonempty_string"},
        "validator_version": {"$ref": "#/$defs/nonempty_string"},
        "passed": {"type": "boolean"},
        "checks": {"type": "object"},
        "normalization_events": {"type": "array", "items": {"type": "object"}},
        "anomalies": {"type": "array", "items": {"type": "object"}}
      }
    },
    "review_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "review_bundle_id", "risk_tier", "member_ids", "membership_sha256", "reviewer", "independence_basis", "disposition"],
      "properties": {
        "schema_version": {"const": "M050-REVIEW-BUNDLE-0.1"},
        "review_bundle_id": {"$ref": "#/$defs/nonempty_string"},
        "risk_tier": {"enum": [1, 2, 3]},
        "member_ids": {"$ref": "#/$defs/string_array"},
        "membership_sha256": {"$ref": "#/$defs/sha256"},
        "reviewer": {"$ref": "#/$defs/nonempty_string"},
        "independence_basis": {"$ref": "#/$defs/nonempty_string"},
        "disposition": {"enum": ["pending", "accepted", "rejected", "human_required"]}
      }
    },
    "layer_e_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "evidence_id", "state", "source_id", "source_sha256", "block_id", "exact_source_text", "normalized_claim", "claim_kind", "stream", "request_id", "response_id"],
      "properties": {
        "schema_version": {"const": "M050-LAYER-E-CANDIDATE-0.1"},
        "evidence_id": {"$ref": "#/$defs/nonempty_string"},
        "state": {"const": "reviewed"},
        "source_id": {"$ref": "#/$defs/nonempty_string"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "block_id": {"$ref": "#/$defs/nonempty_string"},
        "exact_source_text": {"$ref": "#/$defs/nonempty_string"},
        "normalized_claim": {"$ref": "#/$defs/nonempty_string"},
        "claim_kind": {"$ref": "#/$defs/nonempty_string"},
        "stream": {"$ref": "#/$defs/nonempty_string"},
        "request_id": {"$ref": "#/$defs/nonempty_string"},
        "response_id": {"$ref": "#/$defs/nonempty_string"},
        "legacy_record_id": {"type": ["string", "null"]}
      }
    },
    "layer_e": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "evidence_id", "state", "source_id", "source_sha256", "block_id", "exact_source_text", "normalized_claim", "claim_kind", "stream", "request_id", "response_id", "acceptance_receipt_id"],
      "properties": {
        "schema_version": {"const": "M050-LAYER-E-0.1"},
        "evidence_id": {"$ref": "#/$defs/nonempty_string"},
        "state": {"enum": ["accepted", "stale", "superseded"]},
        "source_id": {"$ref": "#/$defs/nonempty_string"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "block_id": {"$ref": "#/$defs/nonempty_string"},
        "exact_source_text": {"$ref": "#/$defs/nonempty_string"},
        "normalized_claim": {"$ref": "#/$defs/nonempty_string"},
        "claim_kind": {"$ref": "#/$defs/nonempty_string"},
        "stream": {"$ref": "#/$defs/nonempty_string"},
        "request_id": {"$ref": "#/$defs/nonempty_string"},
        "response_id": {"$ref": "#/$defs/nonempty_string"},
        "acceptance_receipt_id": {"$ref": "#/$defs/nonempty_string"},
        "legacy_record_id": {"type": ["string", "null"]},
        "supersedes_evidence_id": {"type": ["string", "null"]}
      }
    },
    "layer_m": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "mapping_id", "lifecycle_state", "status", "evidence_id", "vocabulary_version", "subjects", "rationale", "review_receipt_id"],
      "properties": {
        "schema_version": {"const": "M050-LAYER-M-0.1"},
        "mapping_id": {"$ref": "#/$defs/nonempty_string"},
        "lifecycle_state": {"enum": ["proposed", "validated", "reviewed", "accepted", "human_required", "rejected", "stale", "superseded"]},
        "status": {"enum": ["mapped", "unmapped", "ambiguous", "invalid", "human_required"]},
        "evidence_id": {"$ref": "#/$defs/nonempty_string"},
        "vocabulary_version": {"$ref": "#/$defs/nonempty_string"},
        "subjects": {"$ref": "#/$defs/string_array"},
