{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://median.invalid/schemas/m050/extraction-artifacts-0.1.json",
  "title": "MEDIAN v0.5.0 atomic-extraction artifact contracts",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "source_id",
        "ordinal",
        "block_type",
        "start",
        "end",
        "raw_sha256",
        "text",
        "status_markers",
        "claim_bearing",
        "estimated_claims",
        "local_disposition",
        "local_reason_code"
      ],
      "properties": {
        "block_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "source_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "block_type": {
          "enum": [
            "heading",
            "paragraph",
            "list_item",
            "table_row",
            "code_fence",
            "whitespace"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "text": {
          "type": "string"
        },
        "parent_heading": {
          "type": [
            "string",
            "null"
          ]
        },
        "status_markers": {
          "$ref": "#/$defs/string_array"
        },
        "claim_bearing": {
          "type": "boolean"
        },
        "estimated_claims": {
          "type": "integer",
          "minimum": 0
        },
        "local_disposition": {
          "enum": [
            "eligible",
            "context_only",
            "excluded",
            "review_required"
          ]
        },
        "local_reason_code": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "block_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "manifest_id",
        "source_id",
        "source_sha256",
        "normalization_version",
        "blocks"
      ],
      "properties": {
        "schema_version": {
          "const": "M050-BLOCK-MANIFEST-0.1"
        },
        "manifest_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "source_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalization_version": {
          "$ref": "#/$defs/nonempty_string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "block_ids",
        "estimated_tokens",
        "claim_bearing_blocks"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "block_ids": {
          "$ref": "#/$defs/string_array"
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "claim_bearing_blocks": {
          "type": "integer",
          "minimum": 0
        },
        "review_risk": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "chunk_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "plan_id",
        "source_id",
        "block_manifest_id",
        "max_tokens",
        "max_claim_blocks",
        "chunks"
      ],
      "properties": {
        "schema_version": {
          "const": "M050-CHUNK-PLAN-0.1"
        },
        "plan_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "source_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "block_manifest_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_claim_blocks": {
          "type": "integer",
          "minimum": 1
        },
        "chunks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chunk"
          }
        }
      }
    },
    "proposal_atom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "source_id",
        "block_id",
        "exact_source_text",
        "normalized_claim",
        "claim_kind",
        "stream"
      ],
      "properties": {
        "proposal_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "source_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "block_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "exact_source_text": {
          "$ref": "#/$defs/nonempty_string"
        },
        "normalized_claim": {
          "$ref": "#/$defs/nonempty_string"
        },
        "claim_kind": {
          "$ref": "#/$defs/nonempty_string"
        },
        "stream": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "block_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "kind"
      ],
      "properties": {
        "block_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "kind": {
          "enum": [
            "atoms",
            "no_substantive_claim",
            "excluded",
            "review_required"
          ]
        },
        "atoms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proposal_atom"
          }
        },
        "reason_code": {
          "type": "string"
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "proposal_set_id",
        "request_id",
        "source_id",
        "dispositions"
      ],
      "properties": {
        "schema_version": {
          "const": "M050-EVIDENCE-PROPOSAL-0.1"
        },
        "proposal_set_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "request_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "source_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "dispositions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block_disposition"
          }
        }
      }
    },
    "validation_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "report_id",
        "proposal_set_id",
        "validator_version",
        "passed",
        "checks",
        "normalization_events",
        "anomalies"
      ],
      "properties": {
        "schema_version": {
          "const": "M050-VALIDATION-REPORT-0.1"
        },
        "report_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "proposal_set_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "validator_version": {
          "$ref": "#/$defs/nonempty_string"
        },
        "passed": {
          "type": "boolean"
        },
        "checks": {
          "type": "object"
        },
        "normalization_events": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "anomalies": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
